+window.CULTURE_VOCAB=[{"id":"A1","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":1,"head":"Africa","accept":["Africa"],"pos":"(n.)","definition":"the large continent south of Europe","meaning":"非洲","example":"Scientists believe that the first humans lived in ________, and they later spread to other continents.","answers":[["Africa"]],"translation":"科學家相信最早的人類生活在非洲，後來才擴散到其他大陸。"},{"id":"A2","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":2,"head":"African","accept":["African"],"pos":"(adj.)","definition":"from or related to Africa","meaning":"非洲的","example":"Many ________ countries became independent in the 1960s, after being colonies for many years.","answers":[["African"]],"translation":"許多非洲國家在經歷多年殖民統治後，於1960年代獨立。"},{"id":"A3","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":3,"head":"American","accept":["American"],"pos":"(adj.)","definition":"from or related to America or the USA","meaning":"美洲的；美國的","example":"Corn was first grown by ancient ________ peoples, and it later became an important crop around the world.","answers":[["American"]],"translation":"玉米最早由古代美洲民族種植，後來成為全世界重要的作物。"},{"id":"A4","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":4,"head":"ancient","accept":["ancient"],"pos":"(adj.)","definition":"very old; from thousands of years ago","meaning":"古代的","example":"Many ________ cities were built near rivers, because people needed water for drinking and farming.","answers":[["ancient"]],"translation":"許多古代城市都建在河邊，因為人們需要水來飲用和耕種。"},{"id":"A5","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":5,"head":"antiquity","accept":["antiquity"],"pos":"(n.)","definition":"the ancient past, before the Middle Ages","meaning":"古代","example":"Greek ________ laid the foundations for Western philosophy, and thinkers like Plato are still studied today.","answers":[["antiquity"]],"translation":"古希臘時代奠定了西方哲學的基礎，柏拉圖等思想家至今仍被研究。"},{"id":"A6","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":6,"head":"Anubis","accept":["Anubis"],"pos":"(n.)","definition":"the Egyptian god of mummies and the dead","meaning":"阿努比斯","example":"________, the god of mummification, was often depicted overseeing the embalming process.","answers":[["Anubis"]],"translation":"阿努比斯，木乃伊化之神，常被描繪為監督防腐過程。"},{"id":"A7","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":7,"head":"archaeologist","accept":["archaeologist"],"pos":"(n.)","definition":"a person who studies ancient remains","meaning":"考古學家","example":"The ________ carefully examined the artifacts to determine their historical significance.","answers":[["archaeologist"]],"translation":"考古學家仔細檢查文物以確定它們的歷史意義。"},{"id":"A8","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":8,"head":"archaeology","accept":["archaeology"],"pos":"(n.)","definition":"the study of the past by digging up old objects","meaning":"考古學","example":"________ revealed a Bronze Age settlement beneath the modern city, so builders had to stop work for a year.","answers":[["archaeology"]],"translation":"考古學研究發現現代城市底下有一處青銅時代的聚落，因此建商不得不停工一年。"},{"id":"A9","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":9,"head":"artifact","accept":["artifact"],"pos":"(n.)","definition":"an object made by people long ago","meaning":"手工藝品；文物","example":"The Terracotta Warriors show the amazing skills behind ________ in ancient China, and each soldier has a different face.","answers":[["artifacts"]],"translation":"兵馬俑展現了古代中國文物背後驚人的技藝，每一尊士兵的臉都不一樣。"},{"id":"A10","part":"P","section":"Ancient Civilizations & Archaeology 古文明與考古","num":10,"head":"the Book of the Dead","accept":["Book of the Dead","the Book of the Dead"],"pos":"(n.phr.)","definition":"an Egyptian text to guide the dead","meaning":"死者之書","example":"______ ______ ______ ______ ______ contained spells and instructions to guide the deceased through the underworld.","answers":[["the"],["Book"],["of"],["the"],["Dead"]],"translation":"《死者之書》包含了咒語和指南，引導死者穿過冥界。"},{"id":"A11","part":"P","section":"Ancient Civilizations & Archaeology 古文明與考古","num":11,"head":"cave painting","accept":["cave painting"],"pos":"(n.phr.)","definition":"an ancient picture painted on a cave wall","meaning":"洞穴畫","example":"The tribe's ancient ______ ______ were discovered in a remote cave, revealing their rich history.","answers":[["cave"],["paintings"]],"translation":"在一個偏遠的洞穴中發現了部落古老的洞穴畫，揭示了他們豐富的歷史。"},{"id":"A12","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":12,"head":"civilization","accept":["civilization"],"pos":"(n.)","definition":"an advanced society with cities and laws","meaning":"文明","example":"Many ancient ________ originated in fertile valleys and on riverbanks as a result of the development of agriculture.","answers":[["civilizations"]],"translation":"許多古文明因為農業的發展而起源於肥沃的山谷和河岸。"},{"id":"A13","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":13,"head":"civilized","accept":["civilized"],"pos":"(adj.)","definition":"having developed culture, laws and government","meaning":"文明的","example":"Historians consider the Greeks a highly ________ people, because they created democracy, theater and philosophy.","answers":[["civilized"]],"translation":"歷史學家認為希臘人是高度文明的民族，因為他們創造了民主、戲劇和哲學。"},{"id":"A14","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":14,"head":"cuneiform","accept":["cuneiform"],"pos":"(n.)","definition":"ancient wedge-shaped writing","meaning":"楔形文字","example":"________ script was used in ancient Mesopotamia for everything from religious texts to commercial transactions.","answers":[["cuneiform"]],"translation":"楔形文字在古代美索不達米亞用於從宗教文本到商業交易的所有事物。"},{"id":"A15","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":15,"head":"dehydration","accept":["dehydration"],"pos":"(n.)","definition":"removing water from something","meaning":"脫水","example":"________ was a key step in preserving a mummy, removing moisture to prevent decay.","answers":[["dehydration"]],"translation":"脫水是保存木乃伊的關鍵步驟，去除水分以防腐敗。"},{"id":"A16","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":16,"head":"Egypt","accept":["Egypt"],"pos":"(n.)","definition":"a country in North Africa with ancient pyramids","meaning":"埃及","example":"In ________, scribes used hieroglyphs to document the history and rituals of the kingdom.","answers":[["Egypt"]],"translation":"在埃及，文士使用象形文字記錄王國的歷史和儀式。"},{"id":"A17","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":17,"head":"Egyptian","accept":["Egyptian"],"pos":"(adj.)","definition":"from or related to Egypt","meaning":"埃及的","example":"The ________ pyramids stand as a testament to the architectural knowledge of the civilization.","answers":[["Egyptian"]],"translation":"埃及金字塔堅立不搖，見證了這個文明的建築知識。"},{"id":"A18","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":18,"head":"Europe","accept":["Europe"],"pos":"(n.)","definition":"the continent with countries like France and Italy","meaning":"歐洲","example":"The Renaissance began in Italy and then spread across ________, changing art, science and education.","answers":[["Europe"]],"translation":"文藝復興起源於義大利，然後傳遍歐洲，改變了藝術、科學和教育。"},{"id":"A19","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":19,"head":"European","accept":["European"],"pos":"(adj.)","definition":"from or related to Europe","meaning":"歐洲的","example":"________ explorers sailed to America in the 15th century, and their arrival changed native life forever.","answers":[["European"]],"translation":"歐洲探險家在十五世紀航行到美洲，他們的到來永遠改變了原住民的生活。"},{"id":"A20","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":20,"head":"excavate","accept":["excavate"],"pos":"(v.)","definition":"to dig in the ground to find old things","meaning":"挖掘","example":"Archaeologists ________ the site, uncovering artifacts from the Bronze Age.","answers":[["excavated"]],"translation":"考古學家挖掘了該遺址，發現了青銅時代的文物。"},{"id":"A21","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":21,"head":"excavation","accept":["excavation"],"pos":"(n.)","definition":"careful digging to find ancient objects","meaning":"發掘","example":"The ________ at Troy revealed several ancient cities built one on top of another over thousands of years.","answers":[["excavation"]],"translation":"特洛伊的發掘工作揭露了數千年來層層疊建的好幾座古城。"},{"id":"A22","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":22,"head":"Greece","accept":["Greece"],"pos":"(n.)","definition":"a country in southern Europe with an ancient history","meaning":"希臘","example":"Ancient ________ is known as the birthplace of democracy, and the first Olympic Games were held there.","answers":[["Greece"]],"translation":"古希臘被譽為民主的發源地，第一屆奧運會也在那裡舉行。"},{"id":"A23","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":23,"head":"Greek","accept":["Greek"],"pos":"(adj.)","definition":"from or related to Greece","meaning":"希臘的","example":"________ myths are full of gods and heroes, and many English words come from these stories.","answers":[["Greek"]],"translation":"希臘神話中充滿了神祇和英雄，許多英文單字都源自這些故事。"},{"id":"A24","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":24,"head":"hieroglyphics","accept":["hieroglyphics"],"pos":"(n.)","definition":"ancient Egyptian writing using pictures as symbols","meaning":"象形文字","example":"Ancient Egyptians used ________ to document religious stories on the walls of temples and tombs.","answers":[["hieroglyphics"]],"translation":"古埃及人用象形文字在神廟和陵墓的牆上記錄宗教故事。"},{"id":"A25","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":25,"head":"hieroglyphs","accept":["hieroglyphs"],"pos":"(n.)","definition":"ancient Egyptian picture writing","meaning":"象形文字","example":"________ were used by the ancient Egyptians as a writing system to record their language and events.","answers":[["hieroglyphs"]],"translation":"象形文字被古埃及人用作書寫系統，記錄他們的語言和事件。"},{"id":"A26","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":26,"head":"historical","accept":["historical"],"pos":"(adj.)","definition":"related to history or the past","meaning":"歷史的；具歷史價值的","example":"Tainan has many ________ buildings, so it is a great city for learning about Taiwan's past.","answers":[["historical"]],"translation":"台南有許多具有歷史價值的建築，因此是了解台灣過去的好城市。"},{"id":"A27","part":"P","section":"Ancient Civilizations & Archaeology 古文明與考古","num":27,"head":"historical site","accept":["historical site"],"pos":"(n.phr.)","definition":"a place where important past events happened","meaning":"歷史遺址","example":"The ______ ______ was preserved to educate future generations about their ancestors.","answers":[["historical"],["site"]],"translation":"歷史遺址被保存下來，以教育未來世代關於他們的祖先。"},{"id":"A28","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":28,"head":"Inca","accept":["Inca"],"pos":"(n.)","definition":"an ancient empire in South America","meaning":"印加","example":"The ________ empire was the largest empire in pre-Columbian America, with a vast network of roads and bridges.","answers":[["Inca"]],"translation":"印加帝國是前哥倫布時代美洲最大的帝國，擁有廣泛的道路和橋樑網絡。"},{"id":"A29","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":29,"head":"linen","accept":["linen"],"pos":"(n.)","definition":"cloth made from the flax plant","meaning":"亞麻布","example":"The mummy was wrapped in many layers of ________ to protect it.","answers":[["linen"]],"translation":"木乃伊被多層亞麻布包裹以保護它。"},{"id":"A30","part":"P","section":"Ancient Civilizations & Archaeology 古文明與考古","num":30,"head":"Machu Picchu","accept":["Machu Picchu"],"pos":"(n.phr.)","definition":"a famous Inca city high in the Andes","meaning":"馬丘比丘","example":"______ ______ is one of the most iconic remnants of the Inca civilization.","answers":[["Machu"],["Picchu"]],"translation":"馬丘比丘是印加文明最具標誌性的遺跡之一。"},{"id":"A31","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":31,"head":"Maya","accept":["Maya"],"pos":"(n.)","definition":"an ancient civilization of Central America","meaning":"瑪雅","example":"The ________ civilization is renowned for its hieroglyphic script, impressive architecture, and astronomical systems.","answers":[["Maya"]],"translation":"瑪雅文明以其象形文字、令人印象深刻的建築和天文系統而聞名。"},{"id":"A32","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":32,"head":"Mesopotamia","accept":["Mesopotamia"],"pos":"(n.)","definition":"the land between the Tigris and Euphrates rivers","meaning":"美索不達米亞","example":"Ancient ________ is known as the cradle of civilization because writing and cities developed there very early.","answers":[["Mesopotamia"]],"translation":"古代美索不達米亞被稱為文明的搖籃，因為文字和城市很早就在那裡發展起來。"},{"id":"A33","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":33,"head":"mummification","accept":["mummification"],"pos":"(n.)","definition":"the process of making a mummy","meaning":"木乃伊製作","example":"The process of ________ was elaborate and sacred in ancient Egypt.","answers":[["mummification"]],"translation":"在古埃及，製作木乃伊的過程既繁瑣又神聖。"},{"id":"A34","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":34,"head":"mummy","accept":["mummy"],"pos":"(n.)","definition":"a dead body preserved and wrapped in cloth","meaning":"木乃伊","example":"The ________ was preserved with great care to ensure the deceased's passage to the afterlife.","answers":[["mummy"]],"translation":"木乃伊被非常小心地保存，以確保死者通往來世的道路。"},{"id":"A35","part":"P","section":"Ancient Civilizations & Archaeology 古文明與考古","num":35,"head":"the Neolithic Period","accept":["Neolithic Period","the Neolithic Period"],"pos":"(n.phr.)","definition":"the late Stone Age when farming began","meaning":"新石器時代","example":"The tribe's ancestors lived during ______ ______ ______, when agriculture first developed.","answers":[["the"],["Neolithic"],["Period"]],"translation":"部落的祖先生活在新石器時代，當時農業首次發展。"},{"id":"A36","part":"P","section":"Ancient Civilizations & Archaeology 古文明與考古","num":36,"head":"the Palaeolithic Period","accept":["Palaeolithic Period","the Palaeolithic Period"],"pos":"(n.phr.)","definition":"the early Stone Age of hunting and stone tools","meaning":"舊石器時代","example":"Artifacts from ______ ______ ______ show that the tribe's ancestors were skilled hunters.","answers":[["the"],["Palaeolithic"],["Period"]],"translation":"舊石器時代的文物表明部落的祖先是熟練的獵人。"},{"id":"A37","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":37,"head":"papyrus","accept":["papyrus"],"pos":"(n.)","definition":"paper made from a plant in ancient Egypt","meaning":"紙莎草紙","example":"________ was the medium on which Egyptians wrote, allowing for the preservation of documents.","answers":[["papyrus"]],"translation":"紙莎草紙是埃及人書寫的媒介，允許檔的保存。"},{"id":"A38","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":38,"head":"pharaoh","accept":["pharaoh"],"pos":"(n.)","definition":"a ruler of ancient Egypt","meaning":"法老","example":"The tomb of the ________ was filled with treasures and gold, so it was often robbed in ancient times.","answers":[["pharaoh"]],"translation":"法老的陵墓裡裝滿了珍寶和黃金，因此在古代經常遭到盜墓。"},{"id":"A39","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":39,"head":"pit","accept":["pit"],"pos":"(n.)","definition":"a large hole dug in the ground","meaning":"坑","example":"The warriors were arranged in battle formation within the ________ as if to protect the emperor in the afterlife.","answers":[["pit"]],"translation":"戰士們在坑中按戰鬥陣型排列，似乎是為了在來世保護皇帝。"},{"id":"A40","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":40,"head":"pyramid","accept":["pyramid"],"pos":"(n.)","definition":"a huge stone tomb with a pointed top","meaning":"金字塔","example":"The Great ________ of Giza remains a symbol of Egyptian engineering, and it was the tallest building in the world for almost 4,000 years.","answers":[["pyramid"]],"translation":"吉薩大金字塔至今仍是埃及工程技術的象徵，它曾近四千年都是世界上最高的建築。"},{"id":"A41","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":41,"head":"quipu","accept":["quipu"],"pos":"(n.)","definition":"Inca knotted strings used to keep records","meaning":"奇普","example":"The Inca used ________ as a form of record keeping, with different colored strings and knots signifying numbers and information.","answers":[["quipu"]],"translation":"印加人使用奇普作為記錄保持的形式，不同顏色的繩子和結表示數字和資訊。"},{"id":"A42","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":42,"head":"ruins","accept":["ruins"],"pos":"(n.)","definition":"the broken parts left of old buildings","meaning":"廢墟","example":"The tribe's ancient ________ were discovered by archaeologists.","answers":[["ruins"]],"translation":"部落的古代廢墟被考古學家發現。"},{"id":"A43","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":43,"head":"site","accept":["site"],"pos":"(n.)","definition":"a place where something is or was","meaning":"地點；遺址","example":"The ________ of the ancient city was found under a rice field, and digging began the next year.","answers":[["site"]],"translation":"古城遺址在一片稻田下被發現，隔年便開始挖掘。"},{"id":"A44","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":44,"head":"Sumer","accept":["Sumer"],"pos":"(n.)","definition":"the oldest known civilization in Mesopotamia","meaning":"蘇美爾","example":"The civilization of ________ is credited with the creation of one of the first writing systems, cuneiform.","answers":[["Sumer"]],"translation":"蘇美爾文明被認為創造了最早的書寫系統之一——楔形文字。"},{"id":"A45","part":"W","section":"Ancient Civilizations & Archaeology 古文明與考古","num":45,"head":"technique","accept":["technique"],"pos":"(n.)","definition":"a special way of doing something","meaning":"技術；技巧","example":"This ancient ________ of making mummies has disappeared, so scientists study the bodies to learn how it worked.","answers":[["technique"]],"translation":"這種製作木乃伊的古老技術已經失傳，所以科學家研究遺體來了解它的原理。"},{"id":"A46","part":"P","section":"Ancient Civilizations & Archaeology 古文明與考古","num":46,"head":"the Terracotta Army","accept":["Terracotta Army","the Terracotta Army"],"pos":"(n.phr.)","definition":"clay soldier statues buried with China's first emperor","meaning":"兵馬俑","example":"______ ______ ______ was discovered in 1974 near Emperor Qin Shi Huang's tomb in Xi'an.","answers":[["the"],["Terracotta"],["Army"]],"translation":"兵馬俑於1974年在西安秦始皇陵墓附近被發現。"},{"id":"B47","part":"W","section":"Empires, Rulers & Royalty 帝國、統治者與皇室","num":47,"head":"coronation","accept":["coronation"],"pos":"(n.)","definition":"the ceremony of crowning a new king or queen","meaning":"加冕禮","example":"The ________ of the new king was held in Westminster Abbey, and leaders from many countries attended.","answers":[["coronation"]],"translation":"新國王的加冕禮在西敏寺舉行，許多國家的領袖都出席了。"},{"id":"B48","part":"W","section":"Empires, Rulers & Royalty 帝國、統治者與皇室","num":48,"head":"dynasty","accept":["dynasty"],"pos":"(n.)","definition":"a series of rulers from the same family","meaning":"王朝","example":"The Ming ________ oversaw China's great naval expeditions in the 15th century, led by the explorer Zheng He.","answers":[["dynasty"]],"translation":"明朝在十五世紀主導了由探險家鄭和率領的大規模航海遠征。"},{"id":"B49","part":"W","section":"Empires, Rulers & Royalty 帝國、統治者與皇室","num":49,"head":"emperor","accept":["emperor"],"pos":"(n.)","definition":"the male ruler of an empire","meaning":"皇帝","example":"The ________ of the Roman Empire announced Christianity as the official religion, so temples of the old gods were closed.","answers":[["emperor"]],"translation":"羅馬帝國的皇帝宣布基督教為國教，因此舊神祇的神廟紛紛被關閉。"},{"id":"B50","part":"W","section":"Empires, Rulers & Royalty 帝國、統治者與皇室","num":50,"head":"empire","accept":["empire"],"pos":"(n.)","definition":"many lands ruled by one powerful ruler or state","meaning":"帝國","example":"The Roman ________ spread across Europe, North Africa and the Middle East, and Latin became a common language there.","answers":[["empire"]],"translation":"羅馬帝國版圖橫跨歐洲、北非和中東，拉丁語也因此成為當地的共通語言。"},{"id":"B51","part":"W","section":"Empires, Rulers & Royalty 帝國、統治者與皇室","num":51,"head":"heir","accept":["heir"],"pos":"(n.)","definition":"a person who will receive a title or property","meaning":"繼承人","example":"Prince George is the second ________ in line to the throne, so he is already trained for public life.","answers":[["heir"]],"translation":"喬治王子是第二順位王位繼承人，因此他已開始接受公眾生活的訓練。"},{"id":"B52","part":"W","section":"Empires, Rulers & Royalty 帝國、統治者與皇室","num":52,"head":"hereditary","accept":["hereditary"],"pos":"(adj.)","definition":"passed from parent to child","meaning":"世襲的；遺傳的","example":"It is a ________ title, so Mark Howard will become Sir Mark Howard when his father dies.","answers":[["hereditary"]],"translation":"這是一個世襲的頭銜，所以馬克‧霍華德在父親去世後將成為馬克‧霍華德爵士。"},{"id":"B53","part":"P","section":"Empires, Rulers & Royalty 帝國、統治者與皇室","num":53,"head":"His/Her Majesty","accept":["her majesty","his majesty"],"pos":"(n.phr.)","definition":"a polite way to talk about a king or queen","meaning":"陛下","example":"______ ______ was a beloved public figure, so millions of people watched her funeral on TV.","answers":[["Her"],["Majesty"]],"translation":"女王陛下是一位深受愛戴的公眾人物，所以數百萬人觀看了她的電視轉播葬禮。"},{"id":"B54","part":"W","section":"Empires, Rulers & Royalty 帝國、統治者與皇室","num":54,"head":"imperialism","accept":["imperialism"],"pos":"(n.)","definition":"a policy of gaining power by taking control of other lands","meaning":"帝國主義","example":"European ________ reshaped global trade routes in the 19th century, while many Asian and African peoples lost their freedom.","answers":[["imperialism"]],"translation":"歐洲的帝國主義在十九世紀重塑了全球貿易路線，而許多亞洲和非洲民族則失去了自由。"},{"id":"B55","part":"W","section":"Empires, Rulers & Royalty 帝國、統治者與皇室","num":55,"head":"knight","accept":["knight"],"pos":"(n.)","definition":"a soldier of high rank in the Middle Ages","meaning":"騎士","example":"The tribe admired the courage and honor of the ________ in their folklore.","answers":[["knights"]],"translation":"部落在他們的民間傳說中欽佩騎士的勇氣和榮譽。"},{"id":"B56","part":"W","section":"Empires, Rulers & Royalty 帝國、統治者與皇室","num":56,"head":"monarch","accept":["monarch"],"pos":"(n.)","definition":"a king or queen","meaning":"君主","example":"The late Queen Elizabeth II was the longest-reigning ________ in British history, and she ruled for over 70 years.","answers":[["monarch"]],"translation":"已故的伊莉莎白二世是英國史上在位最久的君主，她統治了七十多年。"},{"id":"B57","part":"W","section":"Empires, Rulers & Royalty 帝國、統治者與皇室","num":57,"head":"monarchy","accept":["monarchy"],"pos":"(n.)","definition":"a system where a king or queen rules","meaning":"君主制","example":"Constitutional ________ balances royal tradition with democratic governance, so the king has little real power.","answers":[["monarchy"]],"translation":"君主立憲制在王室傳統與民主治理之間取得平衡，因此國王幾乎沒有實權。"},{"id":"B58","part":"W","section":"Empires, Rulers & Royalty 帝國、統治者與皇室","num":58,"head":"palace","accept":["palace"],"pos":"(n.)","definition":"a large house where a king or queen lives","meaning":"皇宮；宮殿","example":"The royal family lives in the ________, and tourists gather outside to watch the changing of the guard.","answers":[["palace"]],"translation":"皇室成員住在宮殿裡，遊客們聚集在外面觀看衛兵交接儀式。"},{"id":"B59","part":"P","section":"Empires, Rulers & Royalty 帝國、統治者與皇室","num":59,"head":"platinum jubilee","accept":["platinum jubilee"],"pos":"(n.phr.)","definition":"a celebration of 70 years of rule","meaning":"白金禧","example":"The queen celebrated 70 years on the throne with a ______ ______, and there were parties across the country.","answers":[["platinum"],["jubilee"]],"translation":"女王以白金禧慶典慶祝在位七十週年，全國各地都舉辦了派對。"},{"id":"B60","part":"W","section":"Empires, Rulers & Royalty 帝國、統治者與皇室","num":60,"head":"privilege","accept":["privilege"],"pos":"(n.)","definition":"a special right only some people have","meaning":"特權","example":"The royal family enjoys many ________, but its members must also follow strict rules in public.","answers":[["privileges"]],"translation":"王室成員享有許多特權，但他們在公開場合也必須遵守嚴格的規定。"},{"id":"B61","part":"W","section":"Empires, Rulers & Royalty 帝國、統治者與皇室","num":61,"head":"reign","accept":["reign"],"po